# ═══════════════════════════════════════════════════════════════════════════
# PUNT FINANCE — Environment Variables Template
# ───────────────────────────────────────────────────────────────────────────
# HOW TO USE:
#   Local dev  → cp .env.example .env.local  (then fill in real values)
#   Vercel     → Project → Settings → Environment Variables (add each one)
#
# SECURITY RULES (non-negotiable):
#   • NEXT_PUBLIC_* variables are bundled into the browser. NEVER put secrets here.
#   • All other variables are server-only. They never reach the client.
#   • If this file is accidentally committed with real values, rotate ALL keys immediately.
# ═══════════════════════════════════════════════════════════════════════════

# ── Supabase ──────────────────────────────────────────────────────────────
# Dashboard: supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Anthropic ─────────────────────────────────────────────────────────────
# Dashboard: console.anthropic.com → API Keys
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── Upstash Redis ─────────────────────────────────────────────────────────
# Dashboard: console.upstash.com → Redis → your db → REST API tab
UPSTASH_REDIS_REST_URL=https://YOUR_DATABASE.upstash.io
UPSTASH_REDIS_REST_TOKEN=YOUR_TOKEN_HERE

# ── Alpha Vantage ─────────────────────────────────────────────────────────
# Free key: alphavantage.co/support/#api-key
ALPHA_VANTAGE_API_KEY=YOUR_AV_KEY_HERE

# ── Security secrets ──────────────────────────────────────────────────────
# Generate: openssl rand -hex 32
IP_HASH_SALT=REPLACE_WITH_64_RANDOM_HEX_CHARS
# Generate: openssl rand -hex 32
REVALIDATE_SECRET=REPLACE_WITH_64_RANDOM_HEX_CHARS

# ── Application ───────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://puntfinance.com
