{
  "$schema": "https://openapi.vercel.sh/vercel.json",

  "crons": [
    {
      "path":     "/api/revalidate-ledger",
      "schedule": "0 0,6,12,18 * * *"
    }
  ],

  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "no-store, no-cache" }
      ]
    }
  ],

  "regions": ["iad1"],

  "framework": "nextjs"
  
}
